<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.ProductCategoryMapper">
    
    <resultMap id="BaseResultMap" type="com.bjpowernode.model.ProductCategory">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="code" property="code" />
        <result column="description" property="description" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>
    
    <sql id="Base_Column_List">
        id, name, code, description, sort, status, create_time, update_time
    </sql>
    
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product_category
        ORDER BY sort ASC, create_time DESC
    </select>
    
    <select id="selectCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM product_category
    </select>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product_category
        WHERE id = #{id}
    </select>
    
    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product_category
        WHERE code = #{code}
    </select>
    
    <insert id="insert" parameterType="com.bjpowernode.model.ProductCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_category (
            name, code, description, sort, status, create_time, update_time
        ) VALUES (
            #{name}, #{code}, #{description}, #{sort}, #{status}, #{createTime}, #{updateTime}
        )
    </insert>
    
    <update id="update" parameterType="com.bjpowernode.model.ProductCategory">
        UPDATE product_category
        SET name = #{name},
            code = #{code},
            description = #{description},
            sort = #{sort},
            status = #{status},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM product_category
        WHERE id = #{id}
    </delete>
</mapper> 