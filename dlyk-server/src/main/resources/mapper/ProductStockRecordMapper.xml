<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.ProductStockRecordMapper">
    
    <resultMap id="BaseResultMap" type="com.bjpowernode.model.ProductStockRecord">
        <id column="id" property="id" />
        <result column="product_id" property="productId" />
        <result column="quantity" property="quantity" />
        <result column="type" property="type" />
        <result column="remark" property="remark" />
        <result column="create_time" property="createTime" />
    </resultMap>
    
    <sql id="Base_Column_List">
        id, product_id, quantity, type, remark, create_time
    </sql>
    
    <select id="selectByProductId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product_stock_record
        WHERE product_id = #{productId}
        ORDER BY create_time DESC
    </select>
    
    <select id="selectCountByProductId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM product_stock_record
        WHERE product_id = #{productId}
    </select>
    
    <insert id="insert" parameterType="com.bjpowernode.model.ProductStockRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_stock_record (
            product_id, quantity, type, remark, create_time
        ) VALUES (
            #{productId}, #{quantity}, #{type}, #{remark}, #{createTime}
        )
    </insert>
</mapper> 