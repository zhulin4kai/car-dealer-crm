<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.ProductMapper">
    
    <resultMap id="BaseResultMap" type="com.bjpowernode.model.Product">
        <id column="id" property="id" />
        <result column="sku" property="sku" />
        <result column="name" property="name" />
        <result column="category" property="category" />
        <result column="specification" property="specification" />
        <result column="price" property="price" />
        <result column="stock" property="stock" />
        <result column="min_stock" property="minStock" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>
    
    <sql id="Base_Column_List">
        id, sku, name, category, specification, price, stock, min_stock, status, create_time, update_time
    </sql>
    
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product
        ORDER BY create_time DESC
    </select>
    
    <select id="selectCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM product
    </select>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product
        WHERE id = #{id}
    </select>
    
    <select id="selectBySku" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product
        WHERE sku = #{sku}
    </select>
    
    <insert id="insert" parameterType="com.bjpowernode.model.Product" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product (
            sku, name, category, specification, price, stock, min_stock, status, create_time, update_time
        ) VALUES (
            #{sku}, #{name}, #{category}, #{specification}, #{price}, #{stock}, #{minStock}, #{status}, #{createTime}, #{updateTime}
        )
    </insert>
    
    <update id="update" parameterType="com.bjpowernode.model.Product">
        UPDATE product
        SET sku = #{sku},
            name = #{name},
            category = #{category},
            specification = #{specification},
            price = #{price},
            stock = #{stock},
            min_stock = #{minStock},
            status = #{status},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM product
        WHERE id = #{id}
    </delete>
    
    <select id="selectStockAlerts" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product
        WHERE stock <![CDATA[ <= ]]> min_stock
        ORDER BY create_time DESC
    </select>
    
    <select id="selectStockAlertsWithFilter" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product
        WHERE stock <![CDATA[ <= ]]> min_stock
        <if test="sku != null and sku != ''">
            AND sku LIKE CONCAT('%', #{sku}, '%')
        </if>
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="category != null and category != ''">
            AND category = #{category}
        </if>
        ORDER BY create_time DESC
    </select>
    
    <select id="selectStockAlertsCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM product
        WHERE stock <![CDATA[ <= ]]> min_stock
    </select>
    
    <update id="updateStock">
        UPDATE product
        SET stock = stock + #{quantity},
            update_time = NOW()
        WHERE id = #{id}
    </update>
    
    <select id="selectAllOnSale" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM product
        WHERE status = 'on_sale'
        ORDER BY create_time DESC
    </select>
</mapper>