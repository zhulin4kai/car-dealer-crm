# 一键运行环境配置。
# 脚本会按顺序测试这些 Docker Hub 大陆镜像，使用第一个可连通的地址。
DOCKERHUB_MIRRORS=https://docker.1ms.run,https://docker.m.daocloud.io,https://docker.1panel.live,https://docker.xuanyuan.me
# 直接运行 Compose 时使用官方构建镜像；启动脚本会探测并临时替换为可用镜像源。
DOCKERHUB_LIBRARY_PREFIX=

MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0
REDIS_IMAGE=docker.1ms.run/library/redis:7.4-alpine

MYSQL_DATABASE=car_dealer_crm
MYSQL_ROOT_PASSWORD=123456
DB_USERNAME=root
DB_PASSWORD=123456
JWT_SECRET=car-dealer-crm-local-secret

# 演示环境的内部令牌仅在容器网络中使用，不承载 Provider API Key。
DEALER_AI_ENV=local
DEALER_AI_INTERNAL_TOKEN=car-dealer-crm-demo-server-to-ai-token
DEALER_AI_TOOL_TOKEN=car-dealer-crm-demo-ai-to-server-token

WEB_PORT=8080
SERVER_PORT=8089
MYSQL_PORT=13306
REDIS_PORT=16379

VITE_API_BASE_URL=/
NPM_REGISTRY=https://registry.npmmirror.com
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
