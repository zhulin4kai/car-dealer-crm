<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.modules.fulfillment.transaction.persistence.mapper.TTranHistoryMapper">

    <resultMap id="BaseResultMap" type="com.autodealer.crm.modules.fulfillment.transaction.application.api.model.TTranHistory">
        <id column="id" property="id" />
        <result column="tran_id" property="tranId" />
        <result column="stage" property="stage" />
        <result column="reason" property="reason" />
        <result column="money" property="money" />
        <result column="expected_date" property="expectedDate" />
        <result column="create_time" property="createTime" />
        <result column="create_by" property="createBy" />
    </resultMap>

    <insert id="insert" parameterType="com.autodealer.crm.modules.fulfillment.transaction.application.api.model.TTranHistory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_tran_history (tran_id, stage, reason, money, expected_date, create_time, create_by)
        VALUES (#{tranId}, #{stage}, #{reason}, #{money}, #{expectedDate}, #{createTime}, #{createBy})
    </insert>

    <select id="selectByTranId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT id, tran_id, stage, reason, money, expected_date, create_time, create_by
        FROM t_tran_history
        WHERE tran_id = #{tranId,jdbcType=INTEGER}
        ORDER BY create_time DESC
    </select>

</mapper>
