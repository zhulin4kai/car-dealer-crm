<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.mapper.TPasswordHistoryMapper">
  <resultMap id="Base" type="com.autodealer.crm.model.TPasswordHistory">
    <id column="id" property="id"/><result column="user_id" property="userId"/>
    <result column="password_hash" property="passwordHash"/><result column="changed_by" property="changedBy"/>
    <result column="change_reason" property="changeReason"/><result column="changed_at" property="changedAt"/>
  </resultMap>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO t_password_history(user_id,password_hash,changed_by,change_reason,changed_at)
    VALUES(#{userId},#{passwordHash},#{changedBy},#{changeReason},#{changedAt})
  </insert>
  <select id="selectRecent" resultMap="Base">
    SELECT id,user_id,password_hash,changed_by,change_reason,changed_at
    FROM t_password_history WHERE user_id=#{userId} ORDER BY changed_at DESC,id DESC LIMIT #{limit}
  </select>
</mapper>
