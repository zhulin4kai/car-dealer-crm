<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.mapper.TOperationLogMapper">

    <resultMap id="BaseResultMap" type="com.autodealer.crm.model.TOperationLog">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="action_code" property="actionCode" />
        <result column="module_name" property="moduleName" />
        <result column="object_type" property="objectType" />
        <result column="resource_id" property="resourceId" />
        <result column="result" property="result" />
        <result column="detail" property="detail" />
        <result column="ip" property="ip" />
        <result column="request_id" property="requestId" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, user_name, action_code, module_name, object_type, resource_id,
        result, detail, ip, request_id, create_time
    </sql>

    <insert id="insert" parameterType="com.autodealer.crm.model.TOperationLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_operation_log (user_id, user_name, action_code, module_name, object_type, resource_id, result, detail, ip, request_id, create_time)
        VALUES (#{userId}, #{userName}, #{actionCode}, #{moduleName}, #{objectType}, #{resourceId}, #{result}, #{detail}, #{ip}, #{requestId}, #{createTime})
    </insert>

    <select id="selectByModule" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_operation_log
        WHERE module_name = #{module}
        ORDER BY create_time DESC, id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectCountByModule" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM t_operation_log
        WHERE module_name = #{module}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_operation_log
        WHERE user_id = #{userId}
        ORDER BY create_time DESC, id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectByQuery" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_operation_log
        <include refid="Query_Where" />
        ORDER BY create_time DESC, id DESC
    </select>

    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_operation_log
        WHERE id = #{id}
    </select>

    <select id="selectForExport" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_operation_log
        <include refid="Export_Query_Where" />
        ORDER BY create_time DESC, id DESC
        LIMIT #{limit}
    </select>

    <sql id="Query_Where">
        <where>
            <if test="userId != null"> user_id = #{userId} </if>
            <if test="userName != null and userName != ''"> and user_name like concat('%', #{userName}, '%') </if>
            <if test="actionCode != null and actionCode != ''"> and action_code = #{actionCode} </if>
            <if test="moduleName != null and moduleName != ''"> and module_name = #{moduleName} </if>
            <if test="objectType != null and objectType != ''"> and object_type = #{objectType} </if>
            <if test="resourceId != null and resourceId != ''"> and resource_id = #{resourceId} </if>
            <if test="result != null and result != ''"> and result = #{result} </if>
            <if test="ip != null and ip != ''"> and ip = #{ip} </if>
            <if test="requestId != null and requestId != ''"> and request_id = #{requestId} </if>
            <if test="startTime != null"> and create_time &gt;= #{startTime} </if>
            <if test="endTime != null"> and create_time &lt;= #{endTime} </if>
        </where>
    </sql>

    <sql id="Export_Query_Where">
        <where>
            <if test="query.userId != null"> user_id = #{query.userId} </if>
            <if test="query.userName != null and query.userName != ''"> and user_name like concat('%', #{query.userName}, '%') </if>
            <if test="query.actionCode != null and query.actionCode != ''"> and action_code = #{query.actionCode} </if>
            <if test="query.moduleName != null and query.moduleName != ''"> and module_name = #{query.moduleName} </if>
            <if test="query.objectType != null and query.objectType != ''"> and object_type = #{query.objectType} </if>
            <if test="query.resourceId != null and query.resourceId != ''"> and resource_id = #{query.resourceId} </if>
            <if test="query.result != null and query.result != ''"> and result = #{query.result} </if>
            <if test="query.ip != null and query.ip != ''"> and ip = #{query.ip} </if>
            <if test="query.requestId != null and query.requestId != ''"> and request_id = #{query.requestId} </if>
            <if test="query.startTime != null"> and create_time &gt;= #{query.startTime} </if>
            <if test="query.endTime != null"> and create_time &lt;= #{query.endTime} </if>
        </where>
    </sql>

</mapper>
