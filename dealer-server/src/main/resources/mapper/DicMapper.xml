<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.mapper.DicMapper">
    <resultMap id="DicTypeMap" type="com.autodealer.crm.model.TDicType">
        <id column="id" property="id"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_name" property="typeName"/>
        <result column="applicable_module" property="applicableModule"/>
        <result column="enabled" property="enabled"/>
        <result column="built_in" property="builtIn"/>
        <result column="disable_reason" property="disableReason"/>
        <result column="disabled_by" property="disabledBy"/>
        <result column="disabled_time" property="disabledTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <resultMap id="DicValueMap" type="com.autodealer.crm.model.TDicValue">
        <id column="id" property="id"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_value" property="typeValue"/>
        <result column="value_code" property="valueCode"/>
        <result column="order" property="order"/>
        <result column="applicable_module" property="applicableModule"/>
        <result column="enabled" property="enabled"/>
        <result column="built_in" property="builtIn"/>
        <result column="disable_reason" property="disableReason"/>
        <result column="disabled_by" property="disabledBy"/>
        <result column="disabled_time" property="disabledTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectDicTypes" resultMap="DicTypeMap">
        SELECT 
            dt.id,
            dt.type_code,
            dt.type_name,
            dt.applicable_module,
            dt.enabled,
            dt.built_in,
            dt.disable_reason,
            dt.disabled_by,
            dt.disabled_time,
            dt.remark
        FROM t_dic_type dt
        <where>
            <if test="typeCode != null and typeCode != ''">
                AND dt.type_code LIKE CONCAT('%', #{typeCode}, '%')
            </if>
            <if test="typeName != null and typeName != ''">
                AND dt.type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="enabled != null">
                AND dt.enabled = #{enabled}
            </if>
            <if test="applicableModule != null and applicableModule != ''">
                AND dt.applicable_module = #{applicableModule}
            </if>
        </where>
        ORDER BY dt.type_code, dt.id
    </select>

    <select id="selectDicValues" resultMap="DicValueMap">
        SELECT 
            dv.id,
            dv.type_code,
            dv.type_value,
            dv.value_code,
            dv.`order`,
            dv.applicable_module,
            dv.enabled,
            dv.built_in,
            dv.disable_reason,
            dv.disabled_by,
            dv.disabled_time,
            dv.remark
        FROM t_dic_value dv
        LEFT JOIN t_dic_type dt ON dv.type_code = dt.type_code
        <where>
            <if test="typeCode != null and typeCode != ''">
                AND dv.type_code = #{typeCode}
            </if>
            <if test="typeValue != null and typeValue != ''">
                AND dv.type_value LIKE CONCAT('%', #{typeValue}, '%')
            </if>
            <if test="valueCode != null and valueCode != ''">
                AND dv.value_code LIKE CONCAT('%', #{valueCode}, '%')
            </if>
            <if test="enabled != null">
                AND dv.enabled = #{enabled}
            </if>
            <if test="applicableModule != null and applicableModule != ''">
                AND dv.applicable_module = #{applicableModule}
            </if>
        </where>
        ORDER BY dv.type_code, dv.`order`, dv.id
    </select>

    <select id="selectDicTypeById" resultMap="DicTypeMap">
        SELECT 
            id,
            type_code,
            type_name,
            applicable_module,
            enabled,
            built_in,
            disable_reason,
            disabled_by,
            disabled_time,
            remark
        FROM t_dic_type
        <where>
            <if test="id != null">
                id = #{id}
            </if>
        </where>
    </select>

    <select id="selectDicValueById" resultMap="DicValueMap">
        SELECT 
            id,
            type_code,
            type_value,
            value_code,
            `order`,
            applicable_module,
            enabled,
            built_in,
            disable_reason,
            disabled_by,
            disabled_time,
            remark
        FROM t_dic_value
        <where>
            <if test="id != null">
                id = #{id}
            </if>
        </where>
    </select>

    <select id="selectDicTypeByCode" resultMap="DicTypeMap">
        SELECT 
            id,
            type_code,
            type_name,
            applicable_module,
            enabled,
            built_in,
            disable_reason,
            disabled_by,
            disabled_time,
            remark
        FROM t_dic_type
        <where>
            <if test="typeCode != null and typeCode != ''">
                type_code = #{typeCode}
            </if>
        </where>
    </select>

    <select id="selectDicValuesByTypeId" resultMap="DicValueMap">
        SELECT 
            dv.id,
            dv.type_code,
            dv.type_value,
            dv.value_code,
            dv.`order`,
            dv.applicable_module,
            dv.enabled,
            dv.built_in,
            dv.disable_reason,
            dv.disabled_by,
            dv.disabled_time,
            dv.remark
        FROM t_dic_value dv
        INNER JOIN t_dic_type dt ON dv.type_code = dt.type_code
        <where>
            <if test="typeId != null">
                dt.id = #{typeId}
            </if>
            AND dv.enabled = 1
            AND dt.enabled = 1
        </where>
        ORDER BY dv.`order`, dv.id
    </select>

    <insert id="insertDicType" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dic_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">type_code,</if>
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="applicableModule != null and applicableModule != ''">applicable_module,</if>
            <if test="enabled != null">enabled,</if>
            <if test="builtIn != null">built_in,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">#{typeCode},</if>
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="applicableModule != null and applicableModule != ''">#{applicableModule},</if>
            <if test="enabled != null">#{enabled},</if>
            <if test="builtIn != null">#{builtIn},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <insert id="insertDicValue" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dic_value
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">type_code,</if>
            <if test="typeValue != null and typeValue != ''">type_value,</if>
            <if test="valueCode != null and valueCode != ''">value_code,</if>
            <if test="order != null">`order`,</if>
            <if test="applicableModule != null and applicableModule != ''">applicable_module,</if>
            <if test="enabled != null">enabled,</if>
            <if test="builtIn != null">built_in,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">#{typeCode},</if>
            <if test="typeValue != null and typeValue != ''">#{typeValue},</if>
            <if test="valueCode != null and valueCode != ''">#{valueCode},</if>
            <if test="order != null">#{order},</if>
            <if test="applicableModule != null and applicableModule != ''">#{applicableModule},</if>
            <if test="enabled != null">#{enabled},</if>
            <if test="builtIn != null">#{builtIn},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateDicType">
        UPDATE t_dic_type
        <set>
            <if test="dicType.typeName != null">type_name = #{dicType.typeName},</if>
            <if test="dicType.applicableModule != null">applicable_module = #{dicType.applicableModule},</if>
            <if test="dicType.enabled != null">
                enabled = #{dicType.enabled},
                disable_reason = #{dicType.disableReason},
                disabled_by = #{dicType.disabledBy},
                disabled_time = #{dicType.disabledTime},
            </if>
            <if test="dicType.remark != null">remark = #{dicType.remark}</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateDicValue">
        UPDATE t_dic_value
        <set>
            <if test="typeValue != null">type_value = #{typeValue},</if>
            <if test="order != null">`order` = #{order},</if>
            <if test="applicableModule != null">applicable_module = #{applicableModule},</if>
            <if test="enabled != null">
                enabled = #{enabled},
                disable_reason = #{disableReason},
                disabled_by = #{disabledBy},
                disabled_time = #{disabledTime},
            </if>
            <if test="remark != null">remark = #{remark}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteRemarksByDicTypeId">
        DELETE FROM t_tran_remark 
        WHERE note_way IN (
            SELECT id
            FROM t_dic_value
            WHERE type_code = (SELECT type_code FROM t_dic_type WHERE id = #{typeId})
        )
    </delete>
    
    <delete id="deleteDicValuesByTypeId">
        DELETE FROM t_dic_value
        WHERE type_code = (SELECT type_code FROM t_dic_type WHERE id = #{typeId})
    </delete>

    <delete id="deleteRemarksByDicValueId">
        DELETE FROM t_tran_remark WHERE note_way = #{id}
    </delete>
    
    <delete id="deleteDicValue">
        DELETE FROM t_dic_value WHERE id = #{id}
    </delete>
    
    <delete id="deleteRemarksByDicTypeIds">
        DELETE FROM t_tran_remark 
        WHERE note_way IN (
            SELECT id
            FROM t_dic_value
            WHERE type_code IN (SELECT type_code FROM t_dic_type WHERE id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
        )
    </delete>
    
    <delete id="deleteDicValuesByTypeIds">
        DELETE FROM t_dic_value
        WHERE type_code IN (SELECT type_code FROM t_dic_type WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        )
    </delete>
    
    <delete id="deleteDicTypesByIds">
        DELETE FROM t_dic_type
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteRemarksByDicValueIds">
        DELETE FROM t_tran_remark 
        WHERE note_way IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteDicValuesByIds">
        DELETE FROM t_dic_value
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectDicTypesByIds" resultMap="DicTypeMap">
        SELECT 
            id,
            type_code,
            type_name,
            applicable_module,
            enabled,
            built_in,
            disable_reason,
            disabled_by,
            disabled_time,
            remark
        FROM t_dic_type
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <delete id="deleteDicType">
        DELETE FROM t_dic_type WHERE id = #{id}
    </delete>

    <select id="selectDicValueIdsByTypeId" resultType="java.lang.Integer">
        SELECT id
        FROM t_dic_value
        WHERE type_code = (SELECT type_code FROM t_dic_type WHERE id = #{typeId})
    </select>

    <select id="selectDicValueIdsByTypeCode" resultType="java.lang.Integer">
        SELECT id
        FROM t_dic_value
        WHERE type_code = #{typeCode}
    </select>

    <select id="selectTypeCodeById" resultType="java.lang.String">
        SELECT type_code
        FROM t_dic_type
        WHERE id = #{id}
    </select>

    <select id="selectTypeCodesByIds" resultType="java.lang.String">
        SELECT type_code
        FROM t_dic_type
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 检查字典值是否被业务数据引用 -->
    <select id="selectRemarkCountByDicValueIds" resultType="java.lang.Integer">
        SELECT
            (SELECT COUNT(*) FROM t_tran_remark WHERE note_way IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
            + (SELECT COUNT(*) FROM t_clue_remark WHERE note_way IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
            + (SELECT COUNT(*) FROM t_customer_remark WHERE note_way IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
            + (SELECT COUNT(*) FROM t_activity_remark WHERE note_way IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
            + (SELECT COUNT(*) FROM t_clue WHERE appellation IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR need_loan IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR intention_state IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR state IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR source IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
            + (SELECT COUNT(*) FROM t_customer WHERE appellation IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR need_loan IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR intention_state IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR source IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            OR original_clue_source IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
    </select>

    <!-- 批量查询字典值ID（通过多个类型代码） -->
    <select id="selectDicValueIdsByTypeCodes" resultType="java.lang.Integer">
        SELECT id
        FROM t_dic_value
        WHERE type_code IN
        <foreach collection="typeCodes" item="typeCode" open="(" separator="," close=")">
            #{typeCode}
        </foreach>
    </select>
</mapper>
