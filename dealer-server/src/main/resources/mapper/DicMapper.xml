<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bjpowernode.mapper.DicMapper">
    <resultMap id="DicTypeMap" type="com.bjpowernode.model.TDicType">
        <id column="id" property="id"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_name" property="typeName"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <resultMap id="DicValueMap" type="com.bjpowernode.model.TDicValue">
        <id column="id" property="id"/>
        <result column="type_code" property="typeCode"/>
        <result column="type_value" property="typeValue"/>
        <result column="order" property="order"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectDicTypes" resultMap="DicTypeMap">
        SELECT 
            dt.id,
            dt.type_code,
            dt.type_name,
            dt.remark
        FROM t_dic_type dt
        <where>
            <if test="typeCode != null and typeCode != ''">
                AND dt.type_code LIKE CONCAT('%', #{typeCode}, '%')
            </if>
            <if test="typeName != null and typeName != ''">
                AND dt.type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
        </where>
        ORDER BY dt.type_code
    </select>

    <select id="selectDicValues" resultMap="DicValueMap">
        SELECT 
            dv.id,
            dv.type_code,
            dv.type_value,
            dv.`order`,
            dv.remark
        FROM t_dic_value dv
        LEFT JOIN t_dic_type dt ON dv.type_code = dt.type_code
        <where>
            <if test="(typeCode != null and typeCode != '') or (typeValue != null and typeValue != '')">
                <if test="typeCode != null and typeCode != ''">
                    dv.type_code = #{typeCode}
                </if>
                <if test="(typeCode != null and typeCode != '') and (typeValue != null and typeValue != '')">
                    OR
                </if>
                <if test="typeValue != null and typeValue != ''">
                    dv.type_value LIKE CONCAT('%', #{typeValue}, '%')
                </if>
            </if>
        </where>
        ORDER BY dv.`order`
    </select>

    <select id="selectDicTypeById" resultMap="DicTypeMap">
        SELECT 
            id,
            type_code,
            type_name,
            remark
        FROM t_dic_type
        <where>
            <if test="id != null">
                id = #{id}
            </if>
        </where>
    </select>

    <select id="selectDicValueById" resultMap="DicValueMap">
        SELECT 
            id,
            type_code,
            type_value,
            `order`,
            remark
        FROM t_dic_value
        <where>
            <if test="id != null">
                id = #{id}
            </if>
        </where>
    </select>

    <select id="selectDicTypeByCode" resultMap="DicTypeMap">
        SELECT 
            id,
            type_code,
            type_name,
            remark
        FROM t_dic_type
        <where>
            <if test="typeCode != null and typeCode != ''">
                type_code = #{typeCode}
            </if>
        </where>
    </select>

    <select id="selectDicValuesByTypeId" resultMap="DicValueMap">
        SELECT 
            dv.id,
            dv.type_code,
            dv.type_value,
            dv.`order`,
            dv.remark
        FROM t_dic_value dv
        INNER JOIN t_dic_type dt ON dv.type_code = dt.type_code
        <where>
            <if test="typeId != null">
                dt.id = #{typeId}
            </if>
        </where>
        ORDER BY dv.`order`
    </select>

    <insert id="insertDicType" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dic_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">type_code,</if>
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">#{typeCode},</if>
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <insert id="insertDicValue" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dic_value
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">type_code,</if>
            <if test="typeValue != null and typeValue != ''">type_value,</if>
            <if test="order != null">`order`,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="typeCode != null and typeCode != ''">#{typeCode},</if>
            <if test="typeValue != null and typeValue != ''">#{typeValue},</if>
            <if test="order != null">#{order},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="updateDicType">
        UPDATE t_dic_type
        <set>
            <if test="dicType.typeCode != null">type_code = #{dicType.typeCode},</if>
            <if test="dicType.typeName != null">type_name = #{dicType.typeName},</if>
            <if test="dicType.remark != null">remark = #{dicType.remark}</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateDicValue">
        UPDATE t_dic_value
        <set>
            <if test="typeCode != null">type_code = #{typeCode},</if>
            <if test="typeValue != null">type_value = #{typeValue},</if>
            <if test="order != null">`order` = #{order},</if>
            <if test="remark != null">remark = #{remark}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteRemarksByDicTypeId">
        DELETE FROM t_tran_remark 
        WHERE note_way IN (
            SELECT id
            FROM t_dic_value
            WHERE type_code = (SELECT type_code FROM t_dic_type WHERE id = #{typeId})
        )
    </delete>
    
    <delete id="deleteDicValuesByTypeId">
        DELETE FROM t_dic_value
        WHERE type_code = (SELECT type_code FROM t_dic_type WHERE id = #{typeId})
    </delete>

    <delete id="deleteRemarksByDicValueId">
        DELETE FROM t_tran_remark WHERE note_way = #{id}
    </delete>
    
    <delete id="deleteDicValue">
        DELETE FROM t_dic_value WHERE id = #{id}
    </delete>
    
    <delete id="deleteRemarksByDicTypeIds">
        DELETE FROM t_tran_remark 
        WHERE note_way IN (
            SELECT id
            FROM t_dic_value
            WHERE type_code IN (SELECT type_code FROM t_dic_type WHERE id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
            )
        )
    </delete>
    
    <delete id="deleteDicValuesByTypeIds">
        DELETE FROM t_dic_value
        WHERE type_code IN (SELECT type_code FROM t_dic_type WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        )
    </delete>
    
    <delete id="deleteDicTypesByIds">
        DELETE FROM t_dic_type
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteRemarksByDicValueIds">
        DELETE FROM t_tran_remark 
        WHERE note_way IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteDicValuesByIds">
        DELETE FROM t_dic_value
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectDicTypesByIds" resultMap="DicTypeMap">
        SELECT 
            id,
            type_code,
            type_name,
            remark
        FROM t_dic_type
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <delete id="deleteDicType">
        DELETE FROM t_dic_type WHERE id = #{id}
    </delete>

    <select id="selectDicValueIdsByTypeId" resultType="java.lang.Integer">
        SELECT id
        FROM t_dic_value
        WHERE type_code = (SELECT type_code FROM t_dic_type WHERE id = #{typeId})
    </select>

    <select id="selectDicValueIdsByTypeCode" resultType="java.lang.Integer">
        SELECT id
        FROM t_dic_value
        WHERE type_code = #{typeCode}
    </select>

    <select id="selectTypeCodeById" resultType="java.lang.String">
        SELECT type_code
        FROM t_dic_type
        WHERE id = #{id}
    </select>

    <select id="selectTypeCodesByIds" resultType="java.lang.String">
        SELECT type_code
        FROM t_dic_type
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 检查字典值是否被业务数据引用 -->
    <select id="selectRemarkCountByDicValueIds" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM t_tran_remark
        WHERE note_way IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 批量查询字典值ID（通过多个类型代码） -->
    <select id="selectDicValueIdsByTypeCodes" resultType="java.lang.Integer">
        SELECT id
        FROM t_dic_value
        WHERE type_code IN
        <foreach collection="typeCodes" item="typeCode" open="(" separator="," close=")">
            #{typeCode}
        </foreach>
    </select>
</mapper> 