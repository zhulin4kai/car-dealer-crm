<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.mapper.TRefundRequestMapper">

    <resultMap id="BaseResultMap" type="com.autodealer.crm.model.TRefundRequest">
        <id column="id" property="id" />
        <result column="tran_id" property="tranId" />
        <result column="original_payment_id" property="originalPaymentId" />
        <result column="refund_payment_id" property="refundPaymentId" />
        <result column="amount" property="amount" />
        <result column="refund_type" property="refundType" />
        <result column="reason" property="reason" />
        <result column="status" property="status" />
        <result column="requested_by" property="requestedBy" />
        <result column="requested_time" property="requestedTime" />
        <result column="approved_by" property="approvedBy" />
        <result column="approved_time" property="approvedTime" />
        <result column="approve_comment" property="approveComment" />
        <result column="executed_by" property="executedBy" />
        <result column="executed_time" property="executedTime" />
        <result column="create_time" property="createTime" />
        <result column="create_by" property="createBy" />
        <result column="edit_time" property="editTime" />
        <result column="edit_by" property="editBy" />
    </resultMap>

    <sql id="Base_Column_List">
        id, tran_id, original_payment_id, refund_payment_id, amount, refund_type,
        reason, status, requested_by, requested_time, approved_by, approved_time,
        approve_comment, executed_by, executed_time, create_time, create_by, edit_time, edit_by
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_refund_request
        WHERE id = #{id,jdbcType=INTEGER}
    </select>

    <select id="selectByPrimaryKeyForUpdate" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_refund_request
        WHERE id = #{id,jdbcType=INTEGER}
        FOR UPDATE
    </select>

    <select id="selectByTranId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM t_refund_request
        WHERE tran_id = #{tranId,jdbcType=INTEGER}
        ORDER BY create_time DESC
    </select>

    <select id="sumExecutedAmountByOriginalPaymentId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(amount), 0)
        FROM t_refund_request
        WHERE original_payment_id = #{originalPaymentId,jdbcType=INTEGER}
          AND status = 'EXECUTED'
    </select>

    <select id="sumOpenAmountByOriginalPaymentId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(amount), 0)
        FROM t_refund_request
        WHERE original_payment_id = #{originalPaymentId,jdbcType=INTEGER}
          AND status IN ('PENDING_APPROVAL', 'APPROVED')
    </select>

    <insert id="insertSelective" parameterType="com.autodealer.crm.model.TRefundRequest" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_refund_request
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tranId != null">tran_id,</if>
            <if test="originalPaymentId != null">original_payment_id,</if>
            <if test="refundPaymentId != null">refund_payment_id,</if>
            <if test="amount != null">amount,</if>
            <if test="refundType != null">refund_type,</if>
            <if test="reason != null">reason,</if>
            <if test="status != null">status,</if>
            <if test="requestedBy != null">requested_by,</if>
            <if test="requestedTime != null">requested_time,</if>
            <if test="approvedBy != null">approved_by,</if>
            <if test="approvedTime != null">approved_time,</if>
            <if test="approveComment != null">approve_comment,</if>
            <if test="executedBy != null">executed_by,</if>
            <if test="executedTime != null">executed_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="editTime != null">edit_time,</if>
            <if test="editBy != null">edit_by,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="tranId != null">#{tranId},</if>
            <if test="originalPaymentId != null">#{originalPaymentId},</if>
            <if test="refundPaymentId != null">#{refundPaymentId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="refundType != null">#{refundType},</if>
            <if test="reason != null">#{reason},</if>
            <if test="status != null">#{status},</if>
            <if test="requestedBy != null">#{requestedBy},</if>
            <if test="requestedTime != null">#{requestedTime},</if>
            <if test="approvedBy != null">#{approvedBy},</if>
            <if test="approvedTime != null">#{approvedTime},</if>
            <if test="approveComment != null">#{approveComment},</if>
            <if test="executedBy != null">#{executedBy},</if>
            <if test="executedTime != null">#{executedTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="editTime != null">#{editTime},</if>
            <if test="editBy != null">#{editBy},</if>
        </trim>
    </insert>

    <update id="updateApprovalIfPending">
        UPDATE t_refund_request
        SET status = #{newStatus,jdbcType=VARCHAR},
            approved_by = #{approvedBy,jdbcType=INTEGER},
            approved_time = #{approvedTime,jdbcType=TIMESTAMP},
            approve_comment = #{approveComment,jdbcType=VARCHAR},
            edit_by = #{editBy,jdbcType=INTEGER},
            edit_time = #{editTime,jdbcType=TIMESTAMP}
        WHERE id = #{id,jdbcType=INTEGER}
          AND status = 'PENDING_APPROVAL'
    </update>

    <update id="markExecutedIfApproved">
        UPDATE t_refund_request
        SET status = 'EXECUTED',
            refund_payment_id = #{refundPaymentId,jdbcType=INTEGER},
            executed_by = #{executedBy,jdbcType=INTEGER},
            executed_time = #{executedTime,jdbcType=TIMESTAMP},
            edit_by = #{editBy,jdbcType=INTEGER},
            edit_time = #{editTime,jdbcType=TIMESTAMP}
        WHERE id = #{id,jdbcType=INTEGER}
          AND status = 'APPROVED'
    </update>

    <delete id="deleteByTranId">
        DELETE FROM t_refund_request WHERE tran_id = #{tranId,jdbcType=INTEGER}
    </delete>

</mapper>
