<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.modules.identity.persistence.mapper.TRolePermissionOrganizationMapper">
  <select id="selectOrganizationIds" resultType="int">
    SELECT organization_unit_id FROM t_role_permission_organization
    WHERE role_id=#{roleId} AND permission_id=#{permissionId} ORDER BY organization_unit_id
  </select>
  <insert id="insert">
    INSERT INTO t_role_permission_organization(role_id,permission_id,organization_unit_id)
    VALUES(#{roleId},#{permissionId},#{organizationUnitId})
  </insert>
  <delete id="deleteByRoleId">DELETE FROM t_role_permission_organization WHERE role_id=#{roleId}</delete>
</mapper>
