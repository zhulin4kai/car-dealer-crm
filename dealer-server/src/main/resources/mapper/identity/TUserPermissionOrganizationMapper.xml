<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.modules.identity.persistence.mapper.TUserPermissionOrganizationMapper">
  <select id="selectOrganizationIds" resultType="int">
    SELECT organization_unit_id FROM t_user_permission_organization
    WHERE user_permission_id=#{userPermissionId} ORDER BY organization_unit_id
  </select>
  <insert id="insert">
    INSERT INTO t_user_permission_organization(user_permission_id,organization_unit_id)
    VALUES(#{userPermissionId},#{organizationUnitId})
  </insert>
  <delete id="deleteByUserPermissionId">DELETE FROM t_user_permission_organization WHERE user_permission_id=#{userPermissionId}</delete>
</mapper>
