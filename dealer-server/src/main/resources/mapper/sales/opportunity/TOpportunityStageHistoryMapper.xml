<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.autodealer.crm.modules.sales.opportunity.persistence.mapper.TOpportunityStageHistoryMapper">

    <resultMap id="BaseResultMap" type="com.autodealer.crm.modules.sales.opportunity.application.api.model.TOpportunityStageHistory">
        <id column="id" property="id" />
        <result column="opportunity_id" property="opportunityId" />
        <result column="from_stage" property="fromStage" />
        <result column="to_stage" property="toStage" />
        <result column="reason" property="reason" />
        <result column="operate_by" property="operateBy" />
        <result column="operate_time" property="operateTime" />
    </resultMap>

    <insert id="insert" parameterType="com.autodealer.crm.modules.sales.opportunity.application.api.model.TOpportunityStageHistory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_opportunity_stage_history (
            opportunity_id, from_stage, to_stage, reason, operate_by, operate_time
        ) VALUES (
            #{opportunityId}, #{fromStage}, #{toStage}, #{reason}, #{operateBy}, #{operateTime}
        )
    </insert>

    <select id="selectByOpportunityId" resultMap="BaseResultMap">
        SELECT id, opportunity_id, from_stage, to_stage, reason, operate_by, operate_time
        FROM t_opportunity_stage_history
        WHERE opportunity_id = #{opportunityId}
        ORDER BY operate_time ASC, id ASC
    </select>
</mapper>
